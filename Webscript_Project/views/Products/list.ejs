<%- include('../partials/header.ejs') %>
<%- include('../partials/navbar.ejs') %>

<main class="container">
    <div class="row">
        <div class="offset-md-1 col-md-11">
            <h1><%= title %></h1>
            <a href="/product/add" class="btn btn-primary" role="button">
                <i class="fas fa-plus-circle"></i> Add Product
            </a>
            <br> <br>
            <table class="table table-bordered table-striped table-hover">
                <!-- Header Row -->
                <tr>
                    <th class="text-center col-2">Name</th>
                    <th class="text-center col-5">Description</th>
                    <th class="text-center col-1">Price ($)</th>
                    <th class="text-center col-1">Edit/Delete</th>
                    <th class="text-center col-2"></th>
                </tr>
                <!-- Columns -->
                <% for(let count=0; count<Productlist.length;count++) { %>
                    <tr>
                        <td class="text-center col-2"><%= Productlist[count].name %></td>
                        <td class="text-center col-5"><%= Productlist[count].description %></td>
                        <td class="text-center col-1"><%= Productlist[count].price %></td>
                        <td class="text-center col-1">
                            <a href="/product/edit/<%= Productlist[count]._id %>" 
                                class="btn btn-primary btn-sm">
                                <i class="fas fa-pencil-alt"></i> Edit</a>
                            <a href="/product/delete/<%= Productlist[count]._id %>" 
                                // onclick="___" was brought to you by stackoverflow from user Raghav Rach
                                class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">
                                <i class="fa-solid fa-trash"></i> Delete</a>
                        </td>
                        <td class="text-center col-2">
                            <a href="/checkout/<%= Productlist[count]._id %>" 
                                class="btn btn-primary btn-sm">
                                <i class="fa-solid fa-cart-plus"></i> Add to Cart</a>
                        </td>
                    </tr>
                <% } %>
            </table>
        </div>
    </div>
</main>

<%- include('../partials/footer.ejs') %>
