<%- include('partials/header.ejs') %>
  <%- include('partials/navbar.ejs') %>

    <article>
      <h1>
        <%= title %>
      </h1>
      <div>
        <form action="mailto:fulfillments@thecompanyname.ca?subject=New Order Placed" method="post" enctype="text/plain"
          name="newOrder">
          <p>
            <label for="firstName">Enter your First Name</label>
            <input type="text" id="firstName" size="32" placeholder="Enter your First Name" required>
          </p>
          <p>
            <label for="lastName">Enter your Last Name</label>
            <input type="text" id="lastName" size="32" placeholder="Enter your Last Name" required>
          </p>
          <p>
            <label for="streetAddress">Enter your Street Address</label>
            <input type="text" id="streetAddress" size="32" placeholder="Enter your Street Address" required>
          </p>
          <p>
            <label for="postalCode">Enter your Postal Code</label>
            <input type="text" id="postalCode" size="32" placeholder="Enter your Postal Code" required>
          </p>
          <p>
            <label for="townCity">Enter your Town or City</label>
            <input type="text" id="townCity" size="32" placeholder="Enter your Town / City" required>
          </p>
          <p>
            <label for="province">Select your Province</label>
            <input list="provinces" placeholder="Please Select" required>
            <datalist id="provinces">
              <option value="Alberta">
              <option value="British Columbia">
              <option value="Manitoba">
              <option value="New Brunswick">
              <option value="Newfoundland and Labrador">
              <option value="Nova Scotia">
              <option value="Ontario">
              <option value="Prince Edward Island">
              <option value="Quebec">
              <option value="Saskatchewan">
            </datalist>
          </p>
          <p>
            <label for="email">Enter your Email Address</label>
            <input type="email" id="email" size="32" placeholder="Enter your Email Address" required>
          </p>
          <p>
            <label for="phone">Enter your Phone Number</label>
            <input type="tel" id="phone" size="32" placeholder="Enter your Phone Number Here" required>
          </p>
          <p>
            <label for="deliveryInstructions">Special Delivery Instructions (Optional)</label><br>
            <textarea name="message" id="deliveryInstructions" cols="60" rows="5"
              placeholder="Enter your Message Here"></textarea>
          </p>
          <p>
            <input type="submit" value="Submit">
          </p>
        </form>
        </div>

        <%- include('partials/footer.ejs') %>